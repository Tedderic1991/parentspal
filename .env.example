# Demo mode is the default. No Supabase keys are needed to run the app.
PARENTSPAL_DATA_MODE=demo

# Later, set mode to supabase and supply BOTH values to load the venue catalog.
# These are server-only variables, not NEXT_PUBLIC_ variables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Never add a service-role / secret key to browser code or commit credentials.
